<% content_for :title, "Menu · Food Plan Tracker" %>

<header class="safe-top px-5 pb-4">
  <p class="text-xs uppercase tracking-wider text-slate-500"><%= l(Date.current, format: :long) %></p>
  <div class="mt-1 flex items-baseline gap-2 flex-wrap">
    <h1 class="text-2xl font-bold text-slate-900">Today's menu</h1>
    <span class="inline-flex items-center rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium px-2.5 py-1">
      <%= @plan.name %>
    </span>
  </div>
  <p class="text-sm text-slate-500 mt-1"><%= @meals.size %> meals · <%= @plan.target_kcal %> kcal · <%= @plan.target_protein_g.to_i %>g protein</p>

  <%= render "shared/day_toggle", plans: @plans, daily_log: @daily_log, variant: :light %>
</header>

<% if @can_copy_yesterday %>
  <section class="px-4 mb-3">
    <%= button_to copy_yesterday_meal_completions_path,
          method: :post,
          class: "w-full rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-700 text-sm font-medium px-4 py-3 hover:bg-indigo-100 transition flex items-center justify-center gap-2" do %>
      <span aria-hidden="true">↩</span> Log same as yesterday
    <% end %>
  </section>
<% end %>

<section class="px-4 space-y-4 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-3">
  <% @meals.each do |meal| %>
    <%= render "menu/meal_card", meal: meal, completed: @completed_meal_ids.include?(meal.id), daily_log: @daily_log %>
  <% end %>
</section>

<section class="px-4 mt-6">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-5">
    <p class="text-xs uppercase tracking-wider text-slate-500">Daily total (target)</p>
    <div class="mt-2 grid grid-cols-4 gap-3 text-center">
      <div><p class="text-lg font-bold"><%= @plan.target_kcal %></p><p class="text-xs text-slate-500">kcal</p></div>
      <div><p class="text-lg font-bold text-rose-600"><%= @plan.target_protein_g %>g</p><p class="text-xs text-slate-500">P</p></div>
      <div><p class="text-lg font-bold text-amber-600"><%= @plan.target_carbs_g %>g</p><p class="text-xs text-slate-500">C</p></div>
      <div><p class="text-lg font-bold text-emerald-600"><%= @plan.target_fat_g %>g</p><p class="text-xs text-slate-500">F</p></div>
    </div>
  </div>
</section>
