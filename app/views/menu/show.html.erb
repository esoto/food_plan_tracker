<% content_for :title, "Menú · Food Plan Tracker" %>

<header class="px-5 pt-8 pb-4">
  <p class="text-xs uppercase tracking-wider text-slate-500"><%= @plan.name %> · <%= l(Date.current, format: :long) %></p>
  <h1 class="text-2xl font-bold text-slate-900 mt-1">Menú del día</h1>
  <p class="text-sm text-slate-500 mt-1">5 comidas — <%= @plan.target_kcal %> kcal, <%= @plan.target_protein_g %>g proteína</p>
</header>

<section class="px-4 space-y-3">
  <% @meals.each do |meal| %>
    <%= render "menu/meal_card", meal: meal, completed: @completed_meal_ids.include?(meal.id), daily_log: @daily_log %>
  <% end %>
</section>

<section class="px-4 mt-6">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-5">
    <p class="text-xs uppercase tracking-wider text-slate-500">Total del día</p>
    <div class="mt-2 grid grid-cols-4 gap-3 text-center">
      <div><p class="text-lg font-bold"><%= @meals.sum(&:target_kcal) %></p><p class="text-xs text-slate-500">kcal</p></div>
      <div><p class="text-lg font-bold text-rose-600"><%= @meals.sum { |m| m.target_protein_g.to_i } %>g</p><p class="text-xs text-slate-500">P</p></div>
      <div><p class="text-lg font-bold text-amber-600"><%= @meals.sum { |m| m.target_carbs_g.to_i } %>g</p><p class="text-xs text-slate-500">C</p></div>
      <div><p class="text-lg font-bold text-emerald-600"><%= @meals.sum { |m| m.target_fat_g.to_i } %>g</p><p class="text-xs text-slate-500">G</p></div>
    </div>
  </div>
</section>
