<div class="min-h-screen flex flex-col items-center justify-center px-6">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-500 shadow-md mx-auto flex items-center justify-center text-white text-2xl">🥗</div>
      <h1 class="font-bold text-2xl text-slate-900 mt-4">Food Plan Tracker</h1>
      <p class="text-sm text-slate-500 mt-1">Create your account.</p>
    </div>

    <%= form_with model: @user, url: registration_path, class: "space-y-3" do |form| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-3">
          <p class="text-sm font-semibold text-red-900"><%= pluralize(@user.errors.count, "error") %> prohibited this user:</p>
          <ul class="text-sm text-red-700 list-disc list-inside mt-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "Email", class: "block w-full rounded-xl border-slate-300 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-3" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Password (min 12 chars)", maxlength: 72, class: "block w-full rounded-xl border-slate-300 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-3" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password", maxlength: 72, class: "block w-full rounded-xl border-slate-300 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-3" %>
      <%= form.submit "Sign up", class: "w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 shadow-sm cursor-pointer" %>
    <% end %>

    <p class="mt-4 text-center text-sm text-slate-600">
      Already have an account? <%= link_to "Sign in", new_session_path, class: "text-indigo-600 underline hover:no-underline font-medium" %>
    </p>
  </div>
</div>
