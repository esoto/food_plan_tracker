<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
  <%= form_with model: goal, url: goal_path(goal), method: :patch, class: "flex items-end gap-3" do |f| %>
    <div class="flex-1 min-w-0">
      <p class="text-xs uppercase tracking-wider text-slate-500"><%= goal.display_name %></p>
      <p class="text-[11px] text-slate-400 mt-0.5">
        <%= goal.preserve? ? "Preserve" : goal.direction.titleize %> · current <%= goal.current_value.to_f %> <%= goal.unit %>
      </p>
    </div>
    <label class="block w-32">
      <span class="text-[11px] uppercase tracking-wider text-slate-500">Target</span>
      <div class="mt-1 relative">
        <%= f.number_field :target_value, step: 0.1,
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[11px] text-slate-400"><%= goal.unit %></span>
      </div>
    </label>
    <%= f.submit "Save", class: "rounded-xl bg-indigo-600 text-white text-sm font-medium px-3 py-2 hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</div>
