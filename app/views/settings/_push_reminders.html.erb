<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4"
     data-controller="push-subscription"
     data-push-subscription-vapid-public-key-value="<%= PushNotifier.public_key %>">
  <% if PushNotifier.configured? %>
    <p class="text-sm text-slate-700">
      Get a nudge to log your morning weight or take Fibrotina, even when the app is closed. Subscriptions are per-device — enable on each browser/phone you want notified.
    </p>
    <div class="mt-3 flex items-center gap-2">
      <button type="button"
              class="rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 cursor-pointer"
              data-push-subscription-target="toggleButton"
              data-action="click->push-subscription#enable">
        Enable reminders
      </button>
      <%= button_to "Send test push", test_push_subscriptions_path,
            method: :post,
            class: "rounded-xl bg-white border border-slate-200 hover:border-slate-300 text-slate-700 text-sm font-medium px-4 py-2 cursor-pointer" %>
    </div>
    <p class="text-xs text-slate-500 mt-3" data-push-subscription-target="status" aria-live="polite">
      Checking subscription status…
    </p>
    <p class="text-xs text-slate-400 mt-2">
      <strong><%= PushSubscription.count %></strong>
      <%= "subscription".pluralize(PushSubscription.count) %> registered server-side.
    </p>
  <% else %>
    <p class="text-sm text-rose-700">
      Push reminders aren't configured yet. Set <code>VAPID_PUBLIC_KEY</code> and <code>VAPID_PRIVATE_KEY</code> in the environment (see <code>.kamal/secrets.example</code>) and redeploy.
    </p>
  <% end %>
</div>
