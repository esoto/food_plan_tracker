<%= form_with model: [:settings, habit], url: form_url, method: form_method, class: "rounded-2xl bg-white border border-slate-100 shadow-sm p-5 grid gap-4" do |f| %>
  <% if habit.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 px-3 py-2 text-sm text-rose-700">
      <ul class="list-disc list-inside">
        <% habit.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Label</span>
    <%= f.text_field :label, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Description (optional)</span>
    <%= f.text_field :description, class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Icon (single emoji, optional)</span>
    <%= f.text_field :icon, maxlength: 4, placeholder: "💧", class: "mt-1 w-24 rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Cancel", settings_habits_path, class: "rounded-xl text-sm px-4 py-2 text-slate-600 hover:bg-slate-100" %>
    <%= f.submit submit_label, class: "rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-2 hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
