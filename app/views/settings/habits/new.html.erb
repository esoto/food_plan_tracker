<% content_for :title, "New Habit · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <p class="text-sm opacity-80">Settings · Habits</p>
  <h1 class="text-2xl font-bold tracking-tight mt-1">New habit</h1>
</header>

<section class="px-4 mt-6 mb-8 lg:max-w-2xl lg:mx-auto">
  <%= render "form", habit: @habit, form_url: settings_habits_path, form_method: :post, submit_label: "Add habit" %>
</section>
