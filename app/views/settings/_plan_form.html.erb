<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-5">
  <div class="flex items-center justify-between mb-3">
    <div>
      <p class="text-xs uppercase tracking-wider text-slate-500"><%= plan.slug.titleize %> day</p>
      <p class="text-lg font-semibold text-slate-900"><%= plan.name %></p>
    </div>
  </div>
  <%= form_with model: plan, url: plan_path(plan), method: :patch, class: "grid grid-cols-2 gap-3" do |f| %>
    <label class="block">
      <span class="text-[11px] uppercase tracking-wider text-slate-500">Calories</span>
      <div class="mt-1 relative">
        <%= f.number_field :target_kcal, step: 1, min: 1,
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-10" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">kcal</span>
      </div>
    </label>
    <label class="block">
      <span class="text-[11px] uppercase tracking-wider text-rose-600">Protein</span>
      <div class="mt-1 relative">
        <%= f.number_field :target_protein_g, step: 1, min: 1,
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
      </div>
    </label>
    <label class="block">
      <span class="text-[11px] uppercase tracking-wider text-amber-600">Carbs</span>
      <div class="mt-1 relative">
        <%= f.number_field :target_carbs_g, step: 1, min: 1,
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
      </div>
    </label>
    <label class="block">
      <span class="text-[11px] uppercase tracking-wider text-emerald-600">Fat</span>
      <div class="mt-1 relative">
        <%= f.number_field :target_fat_g, step: 1, min: 1,
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
      </div>
    </label>
    <%= f.submit "Save #{plan.name}", class: "col-span-2 rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-2.5 hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</div>
