<% content_for :title, "Settings · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Tune as you progress</p>
      <h1 class="text-3xl font-bold tracking-tight mt-1">Settings ⚙️</h1>
      <p class="text-sm mt-1 opacity-90">Update macro targets and goals as your weight changes.</p>
    </div>
    <%= link_to root_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70", aria: { label: "Back to today" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Plan macro targets</h2>
  <div class="grid gap-3">
    <% @plans.each do |plan| %>
      <%= render "settings/plan_form", plan: plan %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Per-meal targets</h2>
  <p class="text-xs text-slate-500 mb-3">Tune the name, time, and per-meal macros for each plan's 5 feedings.</p>
  <% @plans.each do |plan| %>
    <details class="mb-3 rounded-2xl bg-white border border-slate-100 shadow-sm group [&_summary::-webkit-details-marker]:hidden [&_summary]:list-none">
      <summary class="cursor-pointer px-4 py-3 flex items-center justify-between hover:bg-slate-50 rounded-2xl">
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-500"><%= plan.slug.titleize %> day</p>
          <p class="text-sm font-semibold text-slate-900"><%= plan.name %> · <%= plan.meals.size %> meals</p>
        </div>
        <span class="text-slate-400 group-open:rotate-180 transition text-lg">▾</span>
      </summary>
      <div class="px-3 pb-3 grid gap-2">
        <% plan.meals.ordered.each do |meal| %>
          <%= render "settings/meal_form", meal: meal %>
        <% end %>
      </div>
    </details>
  <% end %>
</section>

<section class="px-4 mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Goal targets</h2>
  <div class="grid gap-3">
    <% @goals.each do |goal| %>
      <%= render "settings/goal_form", goal: goal %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-8">
  <p class="text-xs text-slate-500 leading-relaxed">
    Plan names, slugs, and goal metrics aren't editable from here on purpose — they keep the rest of the app stable. To add or remove a plan/goal, use the Rails console.
  </p>
</section>
