<% content_for :title, "Edit #{@template.label} · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <p class="text-sm opacity-80">Settings · Habits</p>
  <h1 class="text-2xl font-bold tracking-tight mt-1">Edit <%= @template.label %></h1>
</header>

<section class="px-4 mt-6 mb-8">
  <%= render "form", template: @template, form_url: settings_habit_path(@template), form_method: :patch, submit_label: "Save changes" %>
</section>
