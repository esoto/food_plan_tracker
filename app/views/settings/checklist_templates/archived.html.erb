<% content_for :title, "Archived Habits · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-slate-700 via-slate-600 to-slate-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-sm opacity-80">Settings · Habits</p>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Archived habits</h1>
      <p class="text-sm mt-1 opacity-90">Hidden from /checklist; past completion records preserved.</p>
    </div>
    <%= link_to settings_habits_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition", aria: { label: "Back" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6 mb-8 grid gap-2">
  <% if @templates.empty? %>
    <p class="text-sm text-slate-500 italic px-2 py-6 text-center">Nothing archived.</p>
  <% end %>
  <% @templates.each do |template| %>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4 flex items-center gap-3">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-slate-900">
          <% if template.icon.present? %><span class="mr-1"><%= template.icon %></span><% end %>
          <%= template.label %>
        </p>
        <p class="text-xs text-slate-500 mt-0.5">archived <%= template.discarded_at.strftime("%b %-d, %Y") %></p>
      </div>
      <%= button_to "Restore", restore_settings_habit_path(template),
            method: :patch,
            class: "rounded-lg text-xs font-medium px-3 py-1.5 text-emerald-700 hover:bg-emerald-50 cursor-pointer" %>
    </div>
  <% end %>
</section>
