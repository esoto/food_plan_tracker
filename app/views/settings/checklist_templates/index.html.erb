<% content_for :title, "Manage Habits · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Settings · Habits</p>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Habits ✓</h1>
      <p class="text-sm mt-1 opacity-90">Add, edit, reorder, and archive the daily habits on /checklist.</p>
    </div>
    <%= link_to settings_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition", aria: { label: "Back to settings" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6 flex items-center justify-between">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Active (<%= @templates.size %>)</h2>
  <%= link_to "+ New habit", new_settings_habit_path, class: "rounded-xl bg-indigo-600 text-white text-xs font-medium px-3 py-2 hover:bg-indigo-700" %>
</section>

<section class="px-4 mt-3 grid gap-2">
  <% if @templates.empty? %>
    <p class="text-sm text-slate-500 italic px-2 py-6 text-center">No active habits yet — add one above.</p>
  <% end %>
  <% @templates.each_with_index do |template, idx| %>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4 flex items-center gap-3">
      <div class="flex flex-col gap-1 shrink-0">
        <%= button_to move_up_settings_habit_path(template),
              method: :patch, disabled: idx.zero?,
              class: "rounded-lg w-8 h-7 flex items-center justify-center text-slate-500 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer",
              aria: { label: "Move up" } do %>
          ▲
        <% end %>
        <%= button_to move_down_settings_habit_path(template),
              method: :patch, disabled: idx == @templates.size - 1,
              class: "rounded-lg w-8 h-7 flex items-center justify-center text-slate-500 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer",
              aria: { label: "Move down" } do %>
          ▼
        <% end %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-slate-900">
          <% if template.icon.present? %><span class="mr-1"><%= template.icon %></span><% end %>
          <%= template.label %>
        </p>
        <% if template.description.present? %>
          <p class="text-xs text-slate-500 mt-0.5"><%= template.description %></p>
        <% end %>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <%= link_to "Edit", edit_settings_habit_path(template), class: "rounded-lg text-xs font-medium px-3 py-1.5 text-indigo-700 hover:bg-indigo-50" %>
        <%= button_to "Archive", settings_habit_path(template),
              method: :delete,
              form: { data: { turbo_confirm: "Archive \"#{template.label}\"? Past completion records stay intact." } },
              class: "rounded-lg text-xs font-medium px-3 py-1.5 text-rose-700 hover:bg-rose-50 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</section>

<section class="px-4 mt-6 mb-8">
  <%= link_to "View archived →", archived_settings_habits_path, class: "text-xs text-slate-500 hover:text-slate-700" %>
</section>
