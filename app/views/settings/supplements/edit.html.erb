<% content_for :title, "Edit #{@supplement.name} · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <p class="text-sm opacity-80">Settings · Supplements</p>
  <h1 class="text-2xl font-bold tracking-tight mt-1">Edit <%= @supplement.name %></h1>
</header>

<section class="px-4 mt-6 mb-8">
  <%= render "form", supplement: @supplement, form_url: settings_supplement_path(@supplement), form_method: :patch, submit_label: "Save changes" %>
</section>
