<% content_for :title, "Manage Supplements · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Settings · Supplements</p>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Supplements 💊</h1>
      <p class="text-sm mt-1 opacity-90">Add, edit, and archive the supplements that show on /supplements.</p>
    </div>
    <%= link_to settings_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition", aria: { label: "Back to settings" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6 flex items-center justify-between">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Active (<%= @supplements.size %>)</h2>
  <%= link_to "+ New supplement", new_settings_supplement_path, class: "rounded-xl bg-indigo-600 text-white text-xs font-medium px-3 py-2 hover:bg-indigo-700" %>
</section>

<section class="px-4 mt-3 grid gap-2">
  <% if @supplements.empty? %>
    <p class="text-sm text-slate-500 italic px-2 py-6 text-center">No active supplements yet — add one above.</p>
  <% end %>
  <% @supplements.each do |supplement| %>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
      <div class="flex items-start gap-3">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <p class="text-sm font-semibold text-slate-900"><%= supplement.name %></p>
            <% if supplement.critical %>
              <span class="text-[10px] uppercase tracking-wider bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded">Critical</span>
            <% end %>
          </div>
          <p class="text-xs text-slate-500 mt-0.5"><%= supplement.dose %></p>
          <% if supplement.supplement_schedules.any? %>
            <p class="text-[11px] text-slate-400 mt-1">
              <%= supplement.supplement_schedules.map(&:slot_label).uniq.join(" · ") %>
            </p>
          <% else %>
            <p class="text-[11px] text-amber-600 mt-1">No time slot — won't appear on /supplements</p>
          <% end %>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <%= link_to "Edit", edit_settings_supplement_path(supplement), class: "rounded-lg text-xs font-medium px-3 py-1.5 text-indigo-700 hover:bg-indigo-50" %>
          <%= button_to "Archive", settings_supplement_path(supplement),
                method: :delete,
                form: { data: { turbo_confirm: "Archive \"#{supplement.name}\"? Past completion records stay intact." } },
                class: "rounded-lg text-xs font-medium px-3 py-1.5 text-rose-700 hover:bg-rose-50 cursor-pointer" %>
        </div>
      </div>
    </div>
  <% end %>
</section>

<section class="px-4 mt-6 mb-8">
  <%= link_to "View archived →", archived_settings_supplements_path, class: "text-xs text-slate-500 hover:text-slate-700" %>
</section>
