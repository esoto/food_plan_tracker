<%= form_with model: supplement, url: form_url, method: form_method, class: "rounded-2xl bg-white border border-slate-100 shadow-sm p-5 grid gap-4" do |f| %>
  <% if supplement.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 px-3 py-2 text-sm text-rose-700">
      <ul class="list-disc list-inside">
        <% supplement.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Name</span>
    <%= f.text_field :name, required: true, class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Dose</span>
    <%= f.text_field :dose, required: true, placeholder: "e.g. 1 capsule, 5 g", class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <label class="flex items-center gap-2">
    <%= f.check_box :critical, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
    <span class="text-sm text-slate-700">Critical (always taken; surface warnings)</span>
  </label>

  <fieldset class="grid gap-2">
    <legend class="text-xs uppercase tracking-wider text-slate-500">Time slots</legend>
    <%# Sentinel ensures the form always submits a time_slots[] param even
        when no boxes are checked — controllers treat missing-key as
        "leave alone" and empty array as "remove all". The empty string is
        filtered out by the model's slot whitelist. %>
    <%= hidden_field_tag "time_slots[]", "" %>
    <% existing_slots = supplement.supplement_schedules.pluck(:time_slot) %>
    <% SupplementSchedule::TIME_SLOT_LABELS.each do |slot, info| %>
      <label class="flex items-center justify-between rounded-xl border border-slate-200 px-3 py-2 hover:bg-slate-50">
        <span class="text-sm text-slate-700"><%= info[:label] %> <span class="text-xs text-slate-400 ml-1">· <%= info[:time] %></span></span>
        <%= check_box_tag "time_slots[]", slot, existing_slots.include?(slot), class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
      </label>
    <% end %>
  </fieldset>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Notes</span>
    <%= f.text_area :notes, rows: 2, class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-wider text-slate-500">Contraindications</span>
    <%= f.text_area :contraindications, rows: 2, class: "mt-1 w-full rounded-xl border border-slate-300 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
  </label>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Cancel", settings_supplements_path, class: "rounded-xl text-sm px-4 py-2 text-slate-600 hover:bg-slate-100" %>
    <%= f.submit submit_label, class: "rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-2 hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
