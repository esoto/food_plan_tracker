<% content_for :title, "Today · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <p class="text-sm opacity-80"><%= l(Date.current, format: "%A, %B %-d") %></p>
  <h1 class="text-3xl font-bold tracking-tight mt-1">Good day <span class="opacity-80">👋</span></h1>
  <p class="text-sm mt-1 opacity-90">Your plan for today — stay on track.</p>

  <%= render "shared/day_toggle", plans: @plans, daily_log: @daily_log, variant: :dark %>
</header>

<section class="px-4 -mt-6">
  <%= render "today/macro_summary", daily_log: @daily_log, plan: @plan %>
</section>

<section class="px-4 mt-6">
  <%= render "today/weight_input", daily_log: @daily_log %>
</section>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Progress toward goals</h2>
  <div class="grid gap-3">
    <% @goals.each do |goal| %>
      <%= render "today/goal_card", goal: goal %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">5 non-negotiable rules</h2>
  <%= render "today/rules" %>
</section>

<section class="px-4 mt-6">
  <%= link_to progress_path, class: "flex items-center justify-between w-full rounded-2xl bg-white border border-slate-200 px-5 py-4 text-left shadow-sm hover:shadow transition" do %>
    <div>
      <p class="text-sm text-slate-500">See trends</p>
      <p class="font-semibold text-slate-900">Progress & projections →</p>
    </div>
    <div class="text-indigo-600 text-2xl">📈</div>
  <% end %>
</section>
