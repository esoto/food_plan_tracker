<% content_for :title, "Today · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80"><%= l(Date.current, format: "%A, %B %-d") %></p>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Good day <span class="opacity-80">👋</span></h1>
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <%= link_to settings_path, class: "w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70", aria: { label: "Settings" } do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33h0a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51h0a1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82v0a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
        </svg>
      <% end %>
      <button type="button" data-action="click->theme#toggle"
              class="w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70" aria-label="Toggle theme">
        <span class="dark:hidden">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
          </svg>
        </span>
        <span class="hidden dark:inline">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <%= render "shared/day_toggle", plans: @plans, daily_log: @daily_log, variant: :dark %>
</header>

<section class="px-4 -mt-6">
  <%= render "today/macro_summary", daily_log: @daily_log, plan: @plan %>
</section>

<%= render "today/logged_foods", logged_foods: @logged_foods, daily_log: @daily_log %>

<% if @now_meal %>
  <section class="px-4 mt-4">
    <%= link_to menu_path, class: "block rounded-2xl bg-indigo-50 border border-indigo-200 p-4 hover:bg-indigo-100 transition" do %>
      <div class="flex items-center gap-3">
        <div class="text-3xl leading-none"><%= @now_meal.icon %></div>
        <div class="flex-1 min-w-0">
          <p class="text-[10px] uppercase tracking-wider text-indigo-700 font-semibold flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full animate-pulse"></span> Right now · <%= @now_meal.time_of_day %>
          </p>
          <p class="text-lg font-semibold text-slate-900 truncate"><%= @now_meal.name %></p>
          <p class="text-xs text-slate-600 truncate"><%= @now_meal.meal_items.map { |mi| mi.food.name }.first(3).join(" · ") %><%= "…" if @now_meal.meal_items.size > 3 %></p>
        </div>
        <span class="text-indigo-500">→</span>
      </div>
    <% end %>
  </section>
<% end %>

<section class="px-4 mt-6">
  <%= render "today/weight_input", daily_log: @daily_log %>
</section>

<section class="px-4 mt-6">
  <%= render "today/journal_note", daily_log: @daily_log %>
</section>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Progress toward goals</h2>
  <div class="grid gap-3">
    <% @goals.each do |goal| %>
      <%= render "today/goal_card", goal: goal %>
    <% end %>
    <% if @untracked_goal_count.positive? %>
      <%= link_to new_biomarker_entry_path, class: "flex items-center justify-between rounded-2xl bg-white border border-dashed border-slate-300 px-4 py-3 text-left hover:border-indigo-400 hover:bg-indigo-50/50 dark:bg-slate-900 dark:border-slate-700 dark:hover:bg-indigo-500/5 transition" do %>
        <div>
          <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400">+ Log a biomarker</p>
          <p class="text-xs text-slate-500"><%= @untracked_goal_count %> untracked</p>
        </div>
        <span class="text-indigo-500">→</span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">5 non-negotiable rules</h2>
  <%= render "today/rules" %>
</section>

<section class="px-4 mt-6">
  <%= link_to progress_path, class: "flex items-center justify-between w-full rounded-2xl bg-white border border-slate-200 px-5 py-4 text-left shadow-sm hover:shadow transition" do %>
    <div>
      <p class="text-sm text-slate-500">See trends</p>
      <p class="font-semibold text-slate-900">Progress & projections →</p>
    </div>
    <div class="text-indigo-600">
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8M21 7h-5M21 7v5"/>
      </svg>
    </div>
  <% end %>
</section>
