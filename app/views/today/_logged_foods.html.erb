<% if logged_foods.any? %>
  <% target_date = local_assigns[:daily_log]&.date || Date.current %>
  <section class="px-4 mt-6">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
        <%= target_date == Date.current ? "Today's extras" : "Logged foods" %>
      </h2>
      <span class="text-xs text-slate-400"><%= logged_foods.size %> logged</span>
    </div>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
      <% logged_foods.each do |lf| %>
        <div class="flex items-center gap-3 px-4 py-3">
          <span class="inline-block w-2 h-2 rounded-full <%= lf.food.category_colors[:dot] %>"></span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-slate-900 truncate"><%= lf.food.name %></p>
            <p class="text-xs text-slate-500 flex items-center gap-1.5 flex-wrap">
              <%= form_with model: lf, url: logged_food_path(lf), method: :patch, class: "inline-flex items-center", data: { controller: "auto-submit" } do |f| %>
                <%= f.number_field :quantity_grams, value: lf.quantity_grams.to_i, min: 1, step: 1,
                      data: { action: "blur->auto-submit#submit" },
                      aria: { label: "Quantity in grams for #{lf.food.name}" },
                      class: "w-14 rounded-md border border-slate-200 text-xs text-slate-700 px-1.5 py-0.5 focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" %>
                <span class="ml-0.5">g</span>
              <% end %>
              <span>· <%= lf.kcal %> kcal ·</span>
              <span class="text-rose-600"><%= lf.protein_g.to_f.round(0) %>g P</span><span>·</span>
              <span class="text-amber-600"><%= lf.carbs_g.to_f.round(0) %>g C</span><span>·</span>
              <span class="text-emerald-600"><%= lf.fat_g.to_f.round(0) %>g F</span>
            </p>
          </div>
          <%= button_to logged_food_path(lf), method: :delete,
                class: "shrink-0 w-11 h-11 rounded-full text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/30 flex items-center justify-center",
                aria: { label: "Remove #{lf.food.name}" } do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
