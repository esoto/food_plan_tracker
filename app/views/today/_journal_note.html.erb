<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-5">
  <div class="flex items-baseline justify-between mb-2">
    <p class="text-xs uppercase tracking-wider text-slate-500">Notes</p>
    <p class="text-[11px] text-slate-400">saves on blur</p>
  </div>
  <%= form_with model: daily_log, url: daily_log_path(daily_log), method: :patch,
        data: { controller: "auto-submit" } do |f| %>
    <%= f.text_area :notes, rows: 3,
          placeholder: "Energy, sleep, mood, what you ate out, anything you'll want to remember…",
          data: { action: "blur->auto-submit#submit" },
          class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 leading-relaxed" %>
  <% end %>
</div>
