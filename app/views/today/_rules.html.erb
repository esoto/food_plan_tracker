<%
  rules = [
    { icon_path: "M10.5 20.5l10-10a5 5 0 00-7-7l-10 10a5 5 0 007 7zM8 8l8 8", text: "Fibrotina with fatty dinner (7:30 PM) — no exceptions", color: "text-rose-500" },
    { icon_path: "M16 2v20M16 2c1.5 0 3 1 3 3v6c0 1-1 2-2 2h-1M8 2v8M5 2v8M11 2v8M5 10c0 1 1 2 3 2s3-1 3-2", text: "5 meals of 30-45g protein each", color: "text-amber-500" },
    { icon_path: "M6 8v8M3 10v4M18 8v8M21 10v4M6 12h12", text: "CrossFit 3×/week + daily walks", color: "text-indigo-500" },
    { icon_path: "M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z", text: "7-8 hours of sleep — critical to lower CRP", color: "text-violet-500" },
    { icon_path: "M6 3h12l-1 17a2 2 0 01-2 2H9a2 2 0 01-2-2L6 3zM7 9h10", text: "Kefir + fermented foods (kimchi/sauerkraut) daily", color: "text-emerald-500" }
  ]
%>
<div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100 dark:bg-slate-900 dark:border-slate-800 dark:divide-slate-800">
  <% rules.each do |rule| %>
    <div class="flex items-center gap-3 px-4 py-3">
      <svg class="shrink-0 w-6 h-6 <%= rule[:color] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="<%= rule[:icon_path] %>"/>
      </svg>
      <p class="text-sm text-slate-700 dark:text-slate-300"><%= rule[:text] %></p>
    </div>
  <% end %>
</div>
