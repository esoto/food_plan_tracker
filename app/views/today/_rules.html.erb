<div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
  <% [
    { emoji: "💊", text: "Fibrotina with fatty dinner (7:30 PM) — no exceptions" },
    { emoji: "🥩", text: "5 meals of 30-45g protein each" },
    { emoji: "💪", text: "CrossFit 3×/week + daily walks" },
    { emoji: "😴", text: "7-8 hours of sleep — critical to lower CRP" },
    { emoji: "🥛", text: "Kefir + fermented foods (kimchi/sauerkraut) daily" }
  ].each do |rule| %>
    <div class="flex items-center gap-3 px-4 py-3">
      <div class="text-2xl"><%= rule[:emoji] %></div>
      <p class="text-sm text-slate-700"><%= rule[:text] %></p>
    </div>
  <% end %>
</div>
