<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs uppercase tracking-wider text-slate-500"><%= goal.display_name %></p>
      <p class="text-lg font-semibold text-slate-900 mt-0.5"><%= goal.display_progress %></p>
    </div>
    <p class="text-xs text-slate-500 text-right leading-tight">
      <% if goal.preserve? %>
        Preserve<br><span class="text-slate-400"><%= goal.target_value.to_f %> <%= goal.unit %></span>
      <% else %>
        Target<br><span class="text-slate-900 font-medium"><%= goal.target_value.to_f %> <%= goal.unit %></span>
      <% end %>
    </p>
  </div>
  <% if goal.show_progress_bar? %>
    <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
      <div class="h-2 <%= goal.trend_color %> rounded-full transition-all" style="width: <%= goal.progress_pct %>%"></div>
    </div>
  <% end %>
  <p class="mt-1 text-[11px] text-slate-500 text-right"><%= goal.progress_note %></p>
</div>
