<div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs uppercase tracking-wider text-slate-500"><%= goal.display_name %></p>
      <p class="text-lg font-semibold text-slate-900 mt-0.5"><%= goal.display_progress %></p>
    </div>
    <p class="text-xs text-slate-500">
      <%= goal.preserve? ? "Preservar" : "Meta: #{number_with_precision(goal.target_value, precision: goal.target_value % 1 == 0 ? 0 : 1)}#{goal.unit}" %>
    </p>
  </div>
  <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
    <div class="h-2 <%= goal.trend_color %> rounded-full transition-all" style="width: <%= goal.progress_pct %>%"></div>
  </div>
  <p class="mt-1 text-[11px] text-slate-500 text-right"><%= goal.progress_pct %>% hacia la meta</p>
</div>
