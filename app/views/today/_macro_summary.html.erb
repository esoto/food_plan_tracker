<%
  protein_kcal = plan.target_protein_g * 4
  carbs_kcal   = plan.target_carbs_g   * 4
  fat_kcal     = plan.target_fat_g     * 9
  total_kcal   = protein_kcal + carbs_kcal + fat_kcal
  pct = ->(n) { total_kcal.positive? ? (n.to_f / total_kcal * 100).round : 0 }
%>
<div class="rounded-3xl bg-white shadow-sm border border-slate-100 p-5">
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="text-xs uppercase tracking-wider text-slate-500">Daily target</p>
      <p class="text-3xl font-bold text-slate-900 mt-1"><%= number_with_delimiter(plan.target_kcal) %> <span class="text-base font-normal text-slate-500">kcal</span></p>
      <p class="text-xs text-slate-500 mt-1">Consumed: <%= daily_log.consumed_kcal %> kcal</p>
      <p class="text-xs text-indigo-600 font-medium mt-0.5">Deficit <%= ((1 - plan.target_kcal / 2400.0) * 100).round %>% · TDEE 2,400</p>
    </div>
    <div class="shrink-0 w-24 h-24 relative">
      <%= pie_chart(
            {
              "Protein (#{pct.call(protein_kcal)}%)" => protein_kcal,
              "Carbs (#{pct.call(carbs_kcal)}%)"     => carbs_kcal,
              "Fat (#{pct.call(fat_kcal)}%)"         => fat_kcal
            },
            donut: true,
            colors: [ "#f43f5e", "#f59e0b", "#10b981" ],
            library: { plugins: { legend: { display: false }, tooltip: { enabled: false } }, cutout: "65%" },
            height: "96px", width: "96px"
          ) %>
      <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-[10px] text-slate-500">
        <span>kcal</span>
        <span class="font-semibold text-slate-900 text-xs"><%= plan.target_kcal %></span>
      </div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-3 gap-2 text-xs">
    <%= render "today/macro_pill",
        label: "Protein", color: "rose",
        target: plan.target_protein_g, consumed: daily_log.consumed_protein_g, unit: "g" %>
    <%= render "today/macro_pill",
        label: "Carbs", color: "amber",
        target: plan.target_carbs_g, consumed: daily_log.consumed_carbs_g, unit: "g" %>
    <%= render "today/macro_pill",
        label: "Fat", color: "emerald",
        target: plan.target_fat_g, consumed: daily_log.consumed_fat_g, unit: "g" %>
  </div>

  <%= link_to menu_path, class: "mt-5 w-full inline-flex justify-center rounded-2xl bg-indigo-600 text-white font-medium py-3 shadow-sm hover:bg-indigo-700 transition" do %>
    See the 5 meals →
  <% end %>
</div>
