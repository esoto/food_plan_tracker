<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Food Plan Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Food Plan Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#4f46e5">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100" data-controller="theme">
    <%= render "shared/flash" %>

    <main class="max-w-lg lg:max-w-2xl mx-auto pb-32 lg:pb-8 lg:pl-20 min-h-screen">
      <% if fibrotina_due? %>
        <%= render "shared/fibrotina_reminder" %>
      <% end %>
      <%= yield %>
    </main>

    <% if authenticated? %>
      <%= render "shared/side_nav" %>
      <%= render "shared/bottom_nav" %>
    <% end %>
  </body>
</html>
