<% content_for :title, "Foods · Food Plan Tracker" %>

<header class="safe-top px-5 pb-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-slate-900">Food exchanges</h1>
      <p class="text-sm text-slate-500 mt-1">Swap proteins, carbs, or fats while keeping today's macros.</p>
    </div>
    <%= link_to new_food_path(category: @category),
          class: "shrink-0 rounded-full bg-indigo-600 text-white text-xs font-semibold px-3 py-2 hover:bg-indigo-700 transition flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400" do %>
      <span aria-hidden="true">+</span> Add a food
    <% end %>
  </div>
</header>

<nav class="px-4 mb-4">
  <div class="grid grid-cols-4 gap-1.5 rounded-2xl bg-white border border-slate-100 p-1.5 shadow-sm text-xs font-medium">
    <% %w[protein carb fat vegetable].each do |cat| %>
      <% active = @category == cat %>
      <%= link_to Food::CATEGORY_LABELS[cat], exchanges_path(category: cat),
            class: "text-center rounded-xl py-2 transition #{active ? "bg-indigo-600 text-white shadow" : "text-slate-600 hover:bg-slate-50"}" %>
    <% end %>
  </div>
</nav>

<div class="px-4 mb-4">
  <%= form_with url: exchanges_path, method: :get, local: true, class: "flex items-center gap-2" do |f| %>
    <%= f.hidden_field :category, value: @category %>
    <%= f.text_field :q, value: @query, placeholder: "Search…", class: "flex-1 rounded-xl border-slate-300 text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    <%= f.submit "Search", class: "rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-2 hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</div>

<section class="px-4 space-y-2">
  <% if @foods.none? %>
    <p class="text-center text-sm text-slate-500 py-8">No foods found.</p>
  <% end %>
  <% @foods.each do |food| %>
    <%= render "exchanges/food_row", food: food %>
  <% end %>
</section>
