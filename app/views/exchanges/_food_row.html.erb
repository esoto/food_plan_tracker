<article class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4"
         data-controller="food-calc disclose"
         data-food-calc-serving-grams-value="<%= food.serving_grams %>"
         data-food-calc-kcal-value="<%= food.kcal %>"
         data-food-calc-protein-value="<%= food.protein_g %>"
         data-food-calc-carbs-value="<%= food.carbs_g %>"
         data-food-calc-fat-value="<%= food.fat_g %>">
  <div class="flex items-start gap-3">
    <span class="mt-1 inline-block w-2.5 h-2.5 rounded-full <%= food.category_colors[:dot] %>"></span>
    <div class="flex-1 min-w-0">
      <% notes_panel_id = "food-#{food.id}-notes" if food.notes.present? %>
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-semibold text-slate-900 leading-snug" title="<%= food.name %>"><%= food.name %></h3>
        <% if food.notes.present? %>
          <button type="button"
                  data-action="click->disclose#toggle"
                  aria-label="Show notes"
                  aria-expanded="false"
                  aria-controls="<%= notes_panel_id %>"
                  title="Show notes"
                  class="shrink-0 w-6 h-6 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 flex items-center justify-center text-xs font-bold leading-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400">
            <span aria-hidden="true">i</span>
          </button>
        <% end %>
      </div>
      <p class="text-xs text-slate-500 mt-0.5">
        <span data-food-calc-target="serving"><%= food.serving_grams.to_i %></span>g ·
        <span data-food-calc-target="kcal"><%= food.kcal %></span> kcal ·
        <span class="text-rose-600"><span data-food-calc-target="protein"><%= food.protein_g.to_i %></span>g P</span> ·
        <span class="text-amber-600"><span data-food-calc-target="carbs"><%= food.carbs_g.to_i %></span>g C</span> ·
        <span class="text-emerald-600"><span data-food-calc-target="fat"><%= food.fat_g.to_i %></span>g F</span>
      </p>
    </div>
  </div>

  <% if food.notes.present? %>
    <p id="<%= notes_panel_id %>"
       class="hidden mt-3 rounded-xl bg-slate-50 px-3 py-2 text-xs text-slate-600 leading-relaxed"
       data-disclose-target="panel">
      <%= food.notes %>
    </p>
  <% end %>

  <div class="mt-3 flex items-stretch gap-2">
    <div class="grid grid-cols-4 gap-1 text-xs flex-1">
      <% [ 0.5, 1.0, 1.5, 2.0 ].each do |mult| %>
        <button type="button"
                data-action="click->food-calc#setMultiplier"
                data-multiplier="<%= mult %>"
                class="rounded-lg py-1.5 ring-1 ring-slate-200 text-slate-600 hover:bg-slate-50 data-[active=true]:bg-slate-900 data-[active=true]:text-white data-[active=true]:ring-slate-900"
                <%= "data-active=true" if mult == 1.0 %>>
          <%= mult %>×
        </button>
      <% end %>
    </div>
    <%= form_with url: logged_foods_path, class: "shrink-0" do |f| %>
      <%= f.hidden_field :food_id, value: food.id %>
      <%= f.hidden_field :quantity_grams, value: food.serving_grams, data: { food_calc_target: "quantityInput" } %>
      <% if local_assigns[:target_log] %>
        <%= f.hidden_field :daily_log_id, value: target_log.id %>
      <% end %>
      <%= f.submit "+ Log", class: "rounded-lg bg-indigo-600 text-white text-xs font-medium px-3 py-1.5 hover:bg-indigo-700 cursor-pointer h-full" %>
    <% end %>
  </div>
</article>
