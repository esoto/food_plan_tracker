<article class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4"
         data-controller="food-calc"
         data-food-calc-serving-grams-value="<%= food.serving_grams %>"
         data-food-calc-kcal-value="<%= food.kcal %>"
         data-food-calc-protein-value="<%= food.protein_g %>"
         data-food-calc-carbs-value="<%= food.carbs_g %>"
         data-food-calc-fat-value="<%= food.fat_g %>">
  <div class="flex items-start gap-3">
    <span class="mt-1 inline-block w-2.5 h-2.5 rounded-full <%= food.category_colors[:dot] %>"></span>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-semibold text-slate-900 truncate"><%= food.name %></h3>
        <span class="text-xs <%= food.category_colors[:text] %>"><%= food.notes %></span>
      </div>
      <p class="text-xs text-slate-500 mt-0.5">
        <span data-food-calc-target="serving"><%= food.serving_grams.to_i %></span>g ·
        <span data-food-calc-target="kcal"><%= food.kcal %></span> kcal ·
        <span class="text-rose-600"><span data-food-calc-target="protein"><%= food.protein_g.to_i %></span>g P</span> ·
        <span class="text-amber-600"><span data-food-calc-target="carbs"><%= food.carbs_g.to_i %></span>g C</span> ·
        <span class="text-emerald-600"><span data-food-calc-target="fat"><%= food.fat_g.to_i %></span>g F</span>
      </p>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-4 gap-1 text-xs">
    <% [ 0.5, 1.0, 1.5, 2.0 ].each do |mult| %>
      <button type="button"
              data-action="click->food-calc#setMultiplier"
              data-multiplier="<%= mult %>"
              class="rounded-lg py-1.5 ring-1 ring-slate-200 text-slate-600 hover:bg-slate-50 data-[active=true]:bg-slate-900 data-[active=true]:text-white data-[active=true]:ring-slate-900"
              <%= "data-active=true" if mult == 1.0 %>>
        <%= mult %>×
      </button>
    <% end %>
  </div>
</article>
