<nav class="hidden lg:flex fixed inset-y-0 left-0 z-40 w-16 flex-col items-center gap-1 py-4 border-r border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 dark:border-slate-800 dark:bg-slate-900/95 dark:supports-[backdrop-filter]:bg-slate-900/80">
  <% nav_items.each do |item| %>
    <% active = current_page?(item[:path]) %>
    <%= link_to item[:path],
          class: "group flex flex-col items-center gap-1 w-12 py-2 rounded-xl transition #{active ? "bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400" : "text-slate-500 hover:text-slate-800 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800"}",
          aria: { label: item[:label] } do %>
      <%= render "shared/icons/#{item[:icon]}", classes: "w-6 h-6 #{"stroke-2" if active}" %>
      <span class="text-[10px] font-medium leading-none"><%= item[:label] %></span>
    <% end %>
  <% end %>
</nav>
