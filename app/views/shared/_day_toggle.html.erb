<%
  # variant: :dark (for gradient header) or :light (for plain header)
  variant ||= :dark
  wrapper_class =
    case variant
    when :dark
      "mt-5 rounded-full bg-white/15 p-1 flex gap-1"
    else
      "mt-3 rounded-full bg-slate-100 dark:bg-slate-800 p-1 flex gap-1"
    end
  active_class   = variant == :dark ? "bg-white text-indigo-700 ring-1 ring-white/40" : "bg-white text-indigo-700 shadow-sm dark:bg-slate-700 dark:text-indigo-300"
  inactive_class = variant == :dark ? "text-white/90 hover:text-white" : "text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
%>
<%= form_with model: daily_log, url: daily_log_path(daily_log), method: :patch, data: { controller: "auto-submit" }, class: wrapper_class do |f| %>
  <% plans.each do |plan| %>
    <% active = daily_log.plan_id == plan.id %>
    <label class="flex-1 cursor-pointer relative">
      <%= f.radio_button :plan_id, plan.id, checked: active, class: "sr-only peer", data: { action: "change->auto-submit#submit" } %>
      <span class="block text-center text-xs font-medium py-3 rounded-full transition peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400 peer-focus-visible:ring-offset-2 <%= active ? active_class : inactive_class %>">
        <%= plan.name %>
      </span>
    </label>
  <% end %>
<% end %>
