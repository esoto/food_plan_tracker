<% if entries.size >= 2 %>
  <% first = entries.first %>
  <% last  = entries.last %>
  <% days_elapsed = (last.recorded_on - first.recorded_on).to_i %>
  <% weight_delta = (first.value.to_f - last.value.to_f) %>
  <% rate_per_week = days_elapsed.positive? ? (weight_delta / days_elapsed * 7.0) : 0 %>
  <% remaining     = (last.value.to_f - weight_goal.target_value.to_f) %>
  <% weeks_to_goal = rate_per_week.positive? ? (remaining / rate_per_week).round : nil %>

  <div class="grid grid-cols-2 gap-3 text-sm">
    <div class="rounded-xl bg-slate-50 p-3">
      <p class="text-xs text-slate-500">Current rate</p>
      <p class="font-semibold text-slate-900 mt-0.5"><%= rate_per_week.round(2) %> kg/week</p>
    </div>
    <div class="rounded-xl bg-slate-50 p-3">
      <p class="text-xs text-slate-500">Remaining</p>
      <p class="font-semibold text-slate-900 mt-0.5"><%= remaining.round(1) %> kg</p>
    </div>
    <div class="rounded-xl bg-indigo-50 p-3 col-span-2">
      <p class="text-xs text-indigo-700">ETA to goal</p>
      <p class="font-semibold text-indigo-900 mt-0.5">
        <% if weeks_to_goal.nil? || weeks_to_goal < 0 %>
          Adjust your deficit — rate is not positive.
        <% elsif weeks_to_goal.zero? %>
          Goal reached!
        <% else %>
          ≈ <%= weeks_to_goal %> weeks at the current pace
        <% end %>
      </p>
    </div>
  </div>
<% else %>
  <p class="text-sm text-slate-500">Log at least 2 weights (a few days apart) to see the projection.</p>
<% end %>
