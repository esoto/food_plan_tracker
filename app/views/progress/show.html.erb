<% content_for :title, "Progreso · Food Plan Tracker" %>

<header class="px-5 pt-8 pb-4">
  <h1 class="text-2xl font-bold text-slate-900">Progreso</h1>
  <p class="text-sm text-slate-500 mt-1">Tendencias y proyecciones.</p>
</header>

<section class="px-4">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Peso (últimos 90 días)</p>
    <% if @weight_entries.any? %>
      <div class="h-48">
        <%= line_chart @weight_entries.map { |e| [ e.recorded_on, e.value.to_f ] },
                      colors: [ "#4f46e5" ], library: { plugins: { legend: { display: false } } }, height: "192px" %>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <% weights = @weight_entries.map { |e| e.value.to_f } %>
        <div><p class="text-xs text-slate-500">Inicial</p><p class="font-semibold"><%= @weight_goal.starting_value.to_f %> kg</p></div>
        <div><p class="text-xs text-slate-500">Actual</p><p class="font-semibold"><%= weights.last %> kg</p></div>
        <div><p class="text-xs text-slate-500">Meta</p><p class="font-semibold"><%= @weight_goal.target_value.to_f %> kg</p></div>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 text-center py-8">Aún sin mediciones. Registra tu peso en el Dashboard.</p>
    <% end %>
  </div>
</section>

<section class="px-4 mt-4">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Adherencia últimos 14 días</p>
    <% if @recent_logs.any? %>
      <div class="h-40">
        <%= column_chart @recent_logs.map { |l| [ l.date.strftime("%d/%m"), l.checklist_adherence_pct ] },
                        colors: [ "#10b981" ], height: "160px",
                        library: { plugins: { legend: { display: false } }, scales: { y: { max: 100 } } } %>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 text-center py-6">Sin datos aún.</p>
    <% end %>
  </div>
</section>

<section class="px-4 mt-4">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-3">Proyección hacia meta de peso</p>
    <%= render "progress/weight_projection", weight_goal: @weight_goal, entries: @weight_entries %>
  </div>
</section>

<section class="px-4 mt-4 mb-6">
  <h2 class="text-xs uppercase tracking-wider text-slate-500 mb-2">Otras metas</h2>
  <div class="grid gap-2">
    <% @goals.reject { |g| g.metric == "weight_kg" }.each do |goal| %>
      <%= render "today/goal_card", goal: goal %>
    <% end %>
  </div>
</section>
