<% content_for :title, "Progress · Food Plan Tracker" %>

<header class="safe-top px-5 pb-4">
  <h1 class="text-2xl font-bold text-slate-900">Progress</h1>
  <p class="text-sm text-slate-500 mt-1">Trends and projections.</p>
</header>

<div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-3.5 lg:px-4">
<%= render "progress/weekly_summary", summary: @weekly_summary %>

<section class="px-4 mt-4 lg:my-0 lg:px-0 lg:col-span-2">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Weight (last 90 days)</p>
    <% if @weight_entries.any? %>
      <div class="h-48">
        <%= line_chart @weight_entries.map { |e| [ e.recorded_on, e.value.to_f ] },
                      colors: [ "#4f46e5" ], library: { plugins: { legend: { display: false } } }, height: "192px" %>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <% weights = @weight_entries.map { |e| e.value.to_f } %>
        <div><p class="text-xs text-slate-500">Start</p><p class="font-semibold"><%= @weight_goal.starting_value.to_f %> kg</p></div>
        <div><p class="text-xs text-slate-500">Current</p><p class="font-semibold"><%= weights.last %> kg</p></div>
        <div><p class="text-xs text-slate-500">Goal</p><p class="font-semibold"><%= @weight_goal.target_value.to_f %> kg</p></div>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 text-center py-8">No readings yet. Log your weight from the Today tab.</p>
    <% end %>
  </div>
</section>

<section class="px-4 mt-4 lg:my-0 lg:px-0">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Edit a past day</p>
    <p class="text-xs text-slate-500 mb-3">Tap to backfill weight or change the day type.</p>
    <div class="flex gap-1.5 overflow-x-auto -mx-1 px-1 pb-1">
      <% (Date.current - 13..Date.current).to_a.reverse.each do |date| %>
        <% is_today = date == Date.current %>
        <%= link_to (is_today ? root_path : day_path(date)),
              class: "shrink-0 w-12 rounded-xl border text-center py-2 transition #{is_today ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-400'}" do %>
          <p class="text-[10px] uppercase tracking-wider opacity-75"><%= l(date, format: "%a") %></p>
          <p class="text-sm font-semibold mt-0.5"><%= date.day %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="px-4 mt-4 lg:my-0 lg:px-0">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-2">Adherence — last 14 days</p>
    <% if @recent_logs.any? %>
      <div class="h-40">
        <%= column_chart @recent_logs.map { |l| [ l.date.strftime("%m/%d"), l.habit_adherence_pct ] },
                        colors: [ "#10b981" ], height: "160px",
                        library: { plugins: { legend: { display: false } }, scales: { y: { max: 100 } } } %>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 text-center py-6">No data yet.</p>
    <% end %>
  </div>
</section>

<section class="px-4 mt-4 lg:my-0 lg:px-0 lg:col-span-2">
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm p-4">
    <p class="text-xs uppercase tracking-wider text-slate-500 mb-3">Projection toward weight goal</p>
    <%= render "progress/weight_projection", weight_goal: @weight_goal, entries: @weight_entries %>
  </div>
</section>

<section class="px-4 mt-4 mb-6 lg:my-0 lg:px-0 lg:col-span-2">
  <div class="flex items-baseline justify-between mb-2">
    <h2 class="text-xs uppercase tracking-wider text-slate-500">Other goals</h2>
    <%= link_to "+ Log a reading", new_biomarker_entry_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
  </div>
  <div class="grid gap-2 lg:grid-cols-2">
    <% @goals.reject { |g| g.metric == "weight_kg" }.each do |goal| %>
      <%= render "today/goal_card", goal: goal %>
    <% end %>
  </div>
</section>

<%= render "progress/rating_trends", rating_trends: @rating_trends %>
</div>
