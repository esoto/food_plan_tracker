<% content_for :title, "Add a food · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Build your food library</p>
      <h1 class="text-3xl font-bold tracking-tight mt-1">Add a food</h1>
      <p class="text-sm mt-1 opacity-90">Macros per a single serving — the macro calc on Foods scales from there.</p>
    </div>
    <%= link_to exchanges_path(category: @food.category), class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70", aria: { label: "Cancel" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6 lg:max-w-2xl lg:mx-auto">
  <% if @food.errors.any? %>
    <div class="mb-4 rounded-2xl bg-rose-50 border border-rose-200 p-4 text-sm text-rose-900">
      <p class="font-semibold mb-1"><%= pluralize(@food.errors.count, "problem") %> stopped this from saving:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% @food.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @food, url: foods_path, class: "rounded-2xl bg-white border border-slate-100 shadow-sm p-5 space-y-4" do |f| %>
    <label class="block">
      <span class="text-xs uppercase tracking-wider text-slate-500">Name</span>
      <%= f.text_field :name, required: true, autofocus: true, placeholder: "e.g. Greek yogurt 5%",
            class: "mt-1 w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2" %>
    </label>

    <fieldset>
      <legend class="text-xs uppercase tracking-wider text-slate-500">Category</legend>
      <div class="mt-2 grid grid-cols-4 gap-1.5 rounded-xl bg-slate-50 p-1.5 text-xs font-medium">
        <% Food::CATEGORY_LABELS.each do |slug, label| %>
          <label class="cursor-pointer">
            <%= f.radio_button :category, slug, class: "sr-only peer", required: true %>
            <span class="block text-center rounded-lg py-2 transition peer-checked:bg-indigo-600 peer-checked:text-white text-slate-600 hover:bg-white">
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <label class="block">
      <span class="text-xs uppercase tracking-wider text-slate-500">Serving size</span>
      <div class="mt-1 relative">
        <%= f.number_field :serving_grams, step: 0.1, min: 0, required: true, placeholder: "100",
              class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-10" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
      </div>
    </label>

    <div class="grid grid-cols-2 gap-3">
      <label class="block">
        <span class="text-xs uppercase tracking-wider text-slate-500">Calories</span>
        <div class="mt-1 relative">
          <%= f.number_field :kcal, step: 1, min: 0, required: true,
                class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-10" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">kcal</span>
        </div>
      </label>

      <label class="block">
        <span class="text-xs uppercase tracking-wider text-rose-600">Protein</span>
        <div class="mt-1 relative">
          <%= f.number_field :protein_g, step: 0.1, min: 0, required: true,
                class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
        </div>
      </label>

      <label class="block">
        <span class="text-xs uppercase tracking-wider text-amber-600">Carbs</span>
        <div class="mt-1 relative">
          <%= f.number_field :carbs_g, step: 0.1, min: 0, required: true,
                class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
        </div>
      </label>

      <label class="block">
        <span class="text-xs uppercase tracking-wider text-emerald-600">Fat</span>
        <div class="mt-1 relative">
          <%= f.number_field :fat_g, step: 0.1, min: 0, required: true,
                class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-8" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">g</span>
        </div>
      </label>
    </div>

    <label class="block">
      <span class="text-xs uppercase tracking-wider text-slate-500">Notes <span class="text-slate-400 normal-case font-normal">(optional)</span></span>
      <%= f.text_field :notes, placeholder: "e.g. brand, prep, source",
            class: "mt-1 w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2" %>
    </label>

    <%= f.submit "Save food", class: "w-full rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-3 hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</section>
