<% content_for :title, "Notifications · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Push reminders</p>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Notifications 🔔</h1>
      <p class="text-sm mt-1 opacity-90">Manage which reminders fire and when.</p>
    </div>
    <%= link_to settings_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition", aria: { label: "Back to settings" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">This device</h2>
  <%= render "settings/push_reminders" %>
</section>

<section class="px-4 mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Subscribed devices</h2>
  <% if @subscriptions.any? %>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
      <% @subscriptions.each do |sub| %>
        <div class="px-4 py-3 text-sm">
          <p class="text-slate-900 font-medium truncate"><%= sub.user_agent.presence || "Unknown device" %></p>
          <p class="text-xs text-slate-500 mt-0.5">Added <%= sub.created_at.strftime("%b %-d, %Y") %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-slate-500">No devices subscribed yet. Tap "Enable reminders" above on the device you want notified.</p>
  <% end %>
</section>

<section class="px-4 mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Meal reminders <span class="text-[11px] text-slate-400 normal-case font-normal">(today's plan: <%= @plan.name %>)</span></h2>
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
    <% @meal_reminders.each do |entry| %>
      <%= render "notifications/preference_row",
            reminder_type: "meal",
            key: entry[:meal].name,
            label: "#{entry[:meal].icon} #{entry[:meal].name}",
            time:  entry[:meal].time_of_day,
            enabled: entry[:enabled] %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Supplement reminders</h2>
  <div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
    <% @supplement_reminders.each do |entry| %>
      <%= render "notifications/preference_row",
            reminder_type: "supplement_slot",
            key: entry[:slot],
            label: "💊 #{entry[:label]}",
            time:  entry[:time],
            enabled: entry[:enabled] %>
    <% end %>
  </div>
</section>

<section class="px-4 mt-8 mb-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">Recent deliveries</h2>
  <% if @recent_deliveries.any? %>
    <div class="rounded-2xl bg-white border border-slate-100 shadow-sm divide-y divide-slate-100">
      <% @recent_deliveries.each do |d| %>
        <div class="px-4 py-3 text-sm">
          <div class="flex items-baseline justify-between gap-3">
            <p class="text-slate-900 font-medium truncate"><%= d.title %></p>
            <span class="text-xs text-slate-400 shrink-0"><%= d.fired_at.strftime("%b %-d %-l:%M %p") %></span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5 truncate"><%= d.body %></p>
          <p class="text-[11px] text-slate-400 mt-0.5">
            <%= d.sent_count %> sent<% if d.pruned_count.positive? %>, <%= d.pruned_count %> stale subs pruned<% end %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-slate-500">No notifications fired yet. Tap "Send test push" above to verify delivery.</p>
  <% end %>
</section>
