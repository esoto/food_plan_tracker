<% content_for :title, "Log biomarkers · Food Plan Tracker" %>

<header class="safe-top px-5 pb-6 bg-gradient-to-br from-indigo-600 via-indigo-500 to-blue-500 text-white rounded-b-3xl shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm opacity-80">Quarterly panel? Body comp scan?</p>
      <h1 class="text-3xl font-bold tracking-tight mt-1">Log biomarkers</h1>
      <p class="text-sm mt-1 opacity-90">Fill in the metrics you have. Leave the rest blank.</p>
    </div>
    <%= link_to progress_path, class: "shrink-0 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70", aria: { label: "Cancel" } do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    <% end %>
  </div>
</header>

<section class="px-4 mt-6">
  <%= form_with url: bulk_biomarker_entries_path, class: "rounded-2xl bg-white border border-slate-100 shadow-sm p-5 space-y-4" do |f| %>
    <label class="block">
      <span class="text-xs uppercase tracking-wider text-slate-500">Recorded on</span>
      <%= f.date_field :recorded_on, value: @recorded_on, max: Date.current, required: true,
            class: "mt-1 w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2" %>
    </label>

    <div class="space-y-3">
      <% @goals.each do |goal| %>
        <label class="block">
          <span class="text-xs uppercase tracking-wider text-slate-500"><%= goal.display_name %></span>
          <span class="text-[11px] text-slate-400 ml-1">current <%= goal.current_value.to_f %> <%= goal.unit %></span>
          <div class="mt-1 relative">
            <%= number_field_tag "entries[#{goal.id}]", nil, step: 0.01, min: 0,
                  placeholder: "—",
                  class: "w-full rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 px-3 py-2 pr-12" %>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400"><%= goal.unit %></span>
          </div>
        </label>
      <% end %>
    </div>

    <%= f.submit "Save readings", class: "w-full rounded-xl bg-indigo-600 text-white text-sm font-medium px-4 py-3 hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</section>

<section class="px-4 mt-4">
  <p class="text-xs text-slate-500 leading-relaxed">
    Only fields with a value will be logged. Weight readings dated today also update Today's weight.
  </p>
</section>
