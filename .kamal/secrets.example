# Template for .kamal/secrets — populated locally from 1Password
# ("Food Tracker" item, Personal Brand vault). The resolved file is
# gitignored (see /.gitignore) so real values never reach the repo.
#
# Two-step populate:
#
#   1) Resolve 1Password refs (KAMAL_REGISTRY_PASSWORD, ADMIN_EMAIL, ADMIN_PASSWORD):
#        op inject -i .kamal/secrets.example -o .kamal/secrets --force
#
#   2) Substitute the master key from disk (Kamal's dotenv parser doesn't
#      run $(...) shell substitution, so we inline the literal):
#        MK=$(cat config/master.key) && \
#          sed -i '' "s|^RAILS_MASTER_KEY=.*|RAILS_MASTER_KEY='${MK}'|" .kamal/secrets && \
#          unset MK
#
# Verify (label + length only, no values printed):
#   kamal secrets print | awk -F= '/^[A-Z_]+=/ {val=$2; gsub(/^"|"$/,"",val); printf "%-28s length=%d\n", $1, length(val)}'
#
# Wrap every value in single quotes — Kamal 2.x's dotenv parser does shell
# $VAR interpolation on unquoted values, silently corrupting secrets containing
# a literal $.

KAMAL_REGISTRY_PASSWORD='op://Personal Brand/Food Tracker/KAMAL_REGISTRY_PASSWORD'
RAILS_MASTER_KEY='set-by-step-2-above'
POSTGRES_PASSWORD='op://Personal Brand/Food Tracker/POSTGRES_PASSWORD'
# Read-only role used only by the daily backup accessory (see Hetzner VPS
# note → "VPS Postgres Backup" 1Password item). Granted pg_read_all_data;
# never used by the app itself.
BACKUP_POSTGRES_PASSWORD='op://Personal Brand/VPS Postgres Backup/password'
ADMIN_EMAIL='op://Personal Brand/Food Tracker/ADMIN_EMAIL'
ADMIN_PASSWORD='op://Personal Brand/Food Tracker/ADMIN_PASSWORD'

# Resend SMTP relay password (the API key). SMTP username is the literal
# string "resend"; see config/environments/production.rb.
RESEND_API_KEY='op://Personal Brand/Food Tracker/RESEND_API_KEY'

# Web Push (PWA reminders). Generate one keypair per app:
#   bundle exec ruby -rweb-push -e 'k = WebPush.generate_key; puts "PUB=#{k.public_key}"; puts "PRV=#{k.private_key}"'
# Stash both halves in 1Password "Food Tracker" as VAPID_PUBLIC_KEY /
# VAPID_PRIVATE_KEY before the next deploy. Public key is shipped to the
# browser by the settings view (not a secret); private key signs the JWT
# that authorizes pushes (must stay server-side).
VAPID_PUBLIC_KEY='op://Personal Brand/Food Tracker/VAPID_PUBLIC_KEY'
VAPID_PRIVATE_KEY='op://Personal Brand/Food Tracker/VAPID_PRIVATE_KEY'

# API tokens are now managed in the database (see ApiToken model). Create
# one via `kamal app exec --reuse "bin/rails api_tokens:create NAME=<client>"`
# in the running container; the plaintext is printed once. No env var needed.
