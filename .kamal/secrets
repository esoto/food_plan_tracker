# Kamal secrets — safe for git. Read from env; set them on your workstation
# before running `bin/kamal deploy`.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)

# First-deploy seeding credentials — only used on the initial run by db/seeds.rb.
# Rotate your password right after the first sign-in.
ESTEBAN_EMAIL=$ESTEBAN_EMAIL
ESTEBAN_PASSWORD=$ESTEBAN_PASSWORD
